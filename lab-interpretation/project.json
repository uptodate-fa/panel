{
  "name": "lab-interpretation",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "lab-interpretation/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mkdir -p dist/lab-interpretation && cp -r lab-interpretation/src/* dist/lab-interpretation/"
      },
      "outputs": ["{workspaceRoot}/dist/lab-interpretation"]
    },
    "serve": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "lab-interpretation:build",
        "port": 4200,
        "spa": true
      }
    }
  }
}

