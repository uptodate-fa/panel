{
  "name": "drug-interaction",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "drug-interaction/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/drug-interaction",
        "index": "drug-interaction/src/index.html",
        "main": "drug-interaction/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "drug-interaction/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "drug-interaction/public"
          }
        ],
        "styles": [
          "drug-interaction/src/styles.scss"
        ],
        "scripts": [],
        "serviceWorker": false
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "100kb",
              "maximumError": "4mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "8kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "drug-interaction/src/environments/environment.ts",
              "with": "drug-interaction/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "drug-interaction:build:production"
        },
        "development": {
          "buildTarget": "drug-interaction:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "drug-interaction/proxy.conf.json"
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "drug-interaction:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "drug-interaction/jest.config.ts"
      }
    }
  }
}

